# Sao chép thành .env (hoặc .env.local) rồi điền khoá của dự án Supabase.
# Lấy ở: Supabase Dashboard → Project Settings → API
#
# Chỉ dùng ANON key (khoá công khai, an toàn cho trình duyệt).
# TUYỆT ĐỐI không đặt service_role key vào đây — nó nằm trong bundle client.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Máy chủ ván cờ (Cloudflare Durable Object, xem ONLINE.md). Bỏ trống thì nối
# wrangler dev trên máy: ws://localhost:8787
VITE_GAME_SERVER=
